# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_ACCOUNT_DEPLOYMENT_PROFILE=cloud
SDKWORK_ACCOUNT_ENVIRONMENT=staging
SDKWORK_ACCOUNT_PROFILE_ID=cloud.staging
SDKWORK_ACCOUNT_APPLICATION_PUBLIC_HTTP_URL=https://account-staging.sdkwork.com
