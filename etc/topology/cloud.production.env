# Bootstrap profile cloud.production — replace with application-specific values.
SDKWORK_ACCOUNT_DEPLOYMENT_PROFILE=cloud
SDKWORK_ACCOUNT_ENVIRONMENT=production
SDKWORK_ACCOUNT_PROFILE_ID=cloud.production
SDKWORK_ACCOUNT_APPLICATION_PUBLIC_HTTP_URL=https://account.sdkwork.com
SDKWORK_ACCOUNT_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com


