{
  "schemaVersion": 1,
  "kind": "sdkwork.commerce.integration.spec",
  "capability": "account",
  "domain": "commerce",
  "role": "ledger-and-token-bank-foundation",
  "accountTaxonomy": {
    "cash": {
      "assetCode": "cash",
      "currencyCodes": ["CNY", "USD"],
      "purpose": "Fiat balance, refund balance, withdrawal balance, or settlement display where product policy allows it."
    },
    "points": {
      "assetCode": "points",
      "currencyCodes": ["POINT"],
      "purpose": "Traditional points, rewards, redemptions, lots, and expiry."
    },
    "tokenBank": {
      "assetCode": "token_bank",
      "currencyCodes": ["TOKEN_BANK"],
      "capabilityNamespace": "token_bank",
      "purpose": "Unified AI account for consumption, income, spending, holds, settlement, transfer, exchange, and reconciliation."
    }
  },
  "forbiddenAssetCodes": [
    "token",
    "compute_token",
    "compute_credit",
    "llm_token",
    "model_token",
    "auth_token",
    "blockchain_token"
  ],
  "ownedTables": [
    "acct_account",
    "acct_ledger_entry",
    "acct_journal",
    "acct_journal_line",
    "acct_points_lot",
    "acct_points_lot_allocation",
    "acct_hold",
    "acct_transfer",
    "acct_token_bank_exchange_rate",
    "acct_token_bank_exchange_quote",
    "acct_token_bank_exchange_snapshot",
    "acct_token_bank_settlement_snapshot",
    "acct_idempotency_record",
    "acct_outbox_event",
    "acct_billing_history"
  ],
  "ownedApiPrefixes": {
    "app": [
      "/app/v3/api/wallet",
      "/app/v3/api/token_bank",
      "/app/v3/api/billing",
      "/app/v3/api/accounts"
    ],
    "backend": [
      "/backend/v3/api/wallet",
      "/backend/v3/api/token_bank"
    ]
  },
  "upstreamDependencies": [],
  "downstreamConsumers": [
    {
      "capability": "order",
      "integration": "Calls account backend-api for points and Token Bank purchase fulfillment after payment success."
    },
    {
      "capability": "payment",
      "integration": "Indirect via order fulfillment; payment provider execution never writes account ledger directly."
    },
    {
      "capability": "pricing",
      "integration": "Produces pricingSnapshotId and final Token Bank amount for AI settlement."
    },
    {
      "capability": "metering",
      "integration": "Produces usageSnapshotId for raw AI usage consumed by pricing."
    },
    {
      "capability": "ai-runtime",
      "integration": "Requests Token Bank hold/settle/release through backend services."
    }
  ],
  "forbidden": [
    "commerce_order writes",
    "payment provider execution",
    "raw AI model execution",
    "raw usage metering ownership",
    "model pricing formula ownership",
    "provider cost and margin policy ownership",
    "app-api /recharges/* routes",
    "orders.* or recharges.* in account-service facade",
    "alternate AI account asset naming",
    "ambiguous token account asset naming"
  ],
  "sdkFamilies": {
    "owned": [
      "sdkwork-account-app-sdk",
      "sdkwork-account-backend-sdk"
    ],
    "forbiddenInFacade": [
      "sdkwork-order-app-sdk",
      "sdkwork-payment-app-sdk",
      "raw AI runtime SDK calls"
    ]
  },
  "tokenBank": {
    "capabilityNamespace": "token_bank",
    "assetCode": "token_bank",
    "currencyCodes": ["TOKEN_BANK"],
    "displayNames": {
      "en": "Token Bank"
    },
    "exchange": {
      "fromAssetCode": "cash",
      "toAssetCode": "token_bank",
      "toCurrencyCode": "TOKEN_BANK",
      "supportedFiatCurrencies": ["CNY", "USD"],
      "requiresExchangeRateSnapshot": true,
      "defaultRoundingMode": "floor"
    },
    "ownerTypes": ["USER", "ORG", "PROJECT", "SERVICE", "SYSTEM"],
    "accountPurposes": ["GENERAL", "BUDGET", "RESERVE", "SETTLEMENT", "BURN", "SUSPENSE"],
    "requiredOperations": [
      "token_bank.issue",
      "token_bank.purchase_credit",
      "token_bank.grant",
      "token_bank.transfer",
      "token_bank.hold",
      "token_bank.settle",
      "token_bank.release",
      "token_bank.debit",
      "token_bank.service_income",
      "token_bank.burn",
      "token_bank.reverse"
    ]
  },
  "pcPackages": {
    "account-pc-wallet": {
      "ownedUi": [
        "cash-balances",
        "points-balances",
        "token-bank-balances",
        "token-bank-summary",
        "holds",
        "ledger",
        "purchase-dialog",
        "withdraw-dialog"
      ],
      "requiredIntegratorPorts": [
        {
          "capability": "sdkwork-order",
          "port": "order-compatible recharge service",
          "methods": [
            "recharges.packages.list",
            "recharges.settings.retrieve",
            "recharges.orders.create"
          ],
          "purpose": "Token Bank and points purchase order lifecycle stays outside account domain."
        }
      ],
      "forbiddenSdkUsage": [
        "raw HTTP to /recharges/*",
        "orders.* or recharges.* on account-service",
        "raw AI runtime calls from account wallet UI"
      ]
    }
  },
  "implementationPhases": [
    {
      "id": "A1",
      "title": "Greenfield account taxonomy and Token Bank specs",
      "status": "active",
      "repos": ["sdkwork-account"]
    },
    {
      "id": "A2",
      "title": "Ledger schema for cash, points, token_bank, multi-owner accounts, and integer amounts",
      "status": "active",
      "repos": ["sdkwork-account"]
    },
    {
      "id": "A3",
      "title": "Token Bank exchange rates, quotes, and immutable exchange snapshots for CNY/USD",
      "status": "active-contract",
      "repos": ["sdkwork-account", "sdkwork-order", "sdkwork-payment"]
    },
    {
      "id": "A4",
      "title": "Token Bank hold, settle, release, debit, transfer, reverse, service income, burn, and reconciliation APIs",
      "status": "active-contract",
      "repos": ["sdkwork-account"]
    },
    {
      "id": "A5",
      "title": "AI runtime, pricing, and metering integration through usage/pricing snapshots",
      "status": "governed-roadmap",
      "repos": ["sdkwork-account", "sdkwork-pricing", "sdkwork-metering", "sdkwork-ai-runtime"]
    },
    {
      "id": "A6",
      "title": "PC Token Bank wallet UX and SDK facade alignment",
      "status": "active",
      "repos": ["sdkwork-account"]
    }
  ]
}
